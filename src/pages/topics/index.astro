---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmptyState from "../../components/EmptyState.astro";
import { getAllTopics, getLectures } from "../../lib/lectures";
const lectures = await getLectures();
const topics = getAllTopics(lectures);
---
<BaseLayout title="موضوعات | Topics — Mufti Abdul Raheem" description="Browse Mufti Abdul Raheem lecture summaries by topic in Urdu and English.">
  <section class="bg-forest-deep py-16 text-white"><div class="container-site"><p class="eyebrow">Browse the archive</p><h1 class="urdu mt-4 text-5xl font-bold leading-[1.8]">موضوعات</h1><p dir="ltr" class="mt-2 text-white/60">Find lecture summaries grouped by subject.</p></div></section>
  <section class="container-site py-16">
    {topics.length ? <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{topics.map((topic) => <a href={`/topics/${topic.slug}/`} class="focus-ring group border border-forest/12 bg-white p-6 transition hover:-translate-y-1 hover:border-gold/50"><span class="urdu block text-2xl font-bold text-forest">{topic.nameUrdu}</span><span dir="ltr" class="mt-2 block text-sm text-ink/50">{topic.nameEnglish}</span><span class="mt-5 block text-xs font-semibold uppercase tracking-wider text-gold">{topic.count} {topic.count === 1 ? "lecture" : "lectures"} →</span></a>)}</div> : <EmptyState />}
  </section>
</BaseLayout>
