---
import BaseLayout from "../layouts/BaseLayout.astro";
import EmptyState from "../components/EmptyState.astro";
import LectureCard from "../components/LectureCard.astro";
import { getLectures, getAllTopics } from "../lib/lectures";
import { muftiProfile } from "../data/mufti-profile";
const lectures = await getLectures();
const topics = getAllTopics(lectures).sort((a, b) => b.count - a.count).slice(0, 6);
---
<BaseLayout title="مفتی عبد الرحیم — Lecture Summary Archive" description="Explore Mufti Abdul Raheem's public lectures through searchable Urdu and English summaries, topics, and original videos.">
  <section class="home-hero">
    <div class="container-site hero-layout">
      <div>
        <p class="eyebrow" dir="ltr">THE LECTURE ARCHIVE</p>
        <h1 class="urdu hero-title">مفتی عبد الرحیم</h1>
        <p class="hero-name" lang="en" dir="ltr">Mufti Abdul Raheem</p>
        <p class="urdu hero-description">بیانات پڑھیں، موضوعات دریافت کریں، اور علم سے اپنا تعلق مضبوط بنائیں۔</p>
        <p class="hero-caption" lang="en" dir="ltr">Public lectures, thoughtfully organized. Read in Urdu or English, and return to the original talk whenever you need.</p>
        <form action="/search/" class="hero-search" role="search">
          <label class="sr-only" for="home-search">Search lectures in Urdu or English</label>
          <input id="home-search" name="q" type="search" dir="auto" placeholder="عنوان یا موضوع تلاش کریں…" />
          <button type="submit">تلاش کریں <span aria-hidden="true">←</span></button>
        </form>
        <div class="hero-meta"><span class="urdu">{lectures.length} بیانات</span><span>Urdu & English</span><span>Independent archive</span></div>
      </div>
      <aside class="hero-note">
        <span class="note-number" aria-hidden="true">01 — 03</span>
        <h2 class="urdu">علم، سمجھ، عمل</h2>
        <p class="urdu">اصل بیان سے جڑا ہوا، مطالعے کا ایک آسان راستہ۔</p>
        <a href="/bayan/"><span class="urdu">تمام بیانات</span><span aria-hidden="true">←</span></a>
        <a href="/topics/"><span class="urdu">موضوعات کے لحاظ سے پڑھیں</span><span aria-hidden="true">←</span></a>
        <a href="https://www.youtube.com/@muftiabdulraheem" target="_blank" rel="noopener noreferrer"><span>YouTube channel</span><span aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </section>
  <section class="container-site home-section">
    <div class="section-heading"><div><p class="eyebrow">RECENT LECTURES</p><h2 class="urdu">تازہ بیانات</h2></div><a class="text-link" href="/bayan/">تمام بیانات ←</a></div>
    {lectures.length ? <div class="lecture-grid">{lectures.slice(0, 6).map(lecture => <LectureCard lecture={lecture} />)}</div> : <EmptyState />}
  </section>
  {topics.length > 0 && <section class="topic-band"><div class="container-site home-section"><div class="section-heading"><div><p class="eyebrow">EXPLORE BY SUBJECT</p><h2 class="urdu">موضوعات دریافت کریں</h2></div><a href="/topics/" class="text-link">تمام موضوعات ←</a></div><div class="home-topics">{topics.map(topic => <a href={`/topics/${topic.slug}/`}><strong class="urdu">{topic.nameUrdu}</strong><span dir="ltr">{topic.count} {topic.count === 1 ? "lecture" : "lectures"} ↗</span></a>)}</div></div></section>}
  <section class="container-site home-section profile-strip"><div><p class="eyebrow">ABOUT THE SCHOLAR</p><h2 class="urdu">مفتی عبد الرحیم کا تعارف</h2></div><div><p class="urdu">{muftiProfile.shortBiographyUrdu}</p><a href="/about-mufti-abdul-raheem/" class="text-link">مزید تعارف ←</a></div></section>
  <section class="container-site acquisition-note" dir="ltr"><div><strong>Website available for acquisition</strong><p>For inquiries about this website and its digital assets.</p></div><a class="text-link" href="/contact/#acquisition">Contact the owner ↗</a></section>
</BaseLayout>
