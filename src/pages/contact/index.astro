---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";
---
<BaseLayout title="رابطہ | Contact — Mufti Abdul Raheem Archive" description="Contact the independent Mufti Abdul Raheem lecture archive owner by email or WhatsApp.">
  <section class="bg-forest-deep py-16 text-white"><div class="container-site max-w-5xl"><p class="eyebrow">Contact</p><h1 class="urdu mt-4 text-5xl font-bold leading-[1.8]">رابطہ</h1><p dir="ltr" class="mt-2 text-white/60">Website inquiries and acquisition information</p></div></section>
  <section class="container-site grid max-w-5xl gap-8 py-16 md:grid-cols-2">
    <div class="border border-forest/12 bg-white p-8"><p class="eyebrow">Website inquiries</p><h2 class="urdu mt-3 text-3xl font-bold text-forest">ویب سائٹ سے متعلق رابطہ</h2><p dir="ltr" class="mt-5 leading-7 text-ink/60">For corrections, website questions, or technical inquiries, contact the owner directly.</p><div class="mt-8 flex flex-wrap gap-3"><a href={`mailto:${site.email}`} class="focus-ring rounded-full bg-forest px-5 py-3 text-sm font-bold text-white">Email</a><a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" class="focus-ring rounded-full border border-forest/20 px-5 py-3 text-sm font-bold text-forest">WhatsApp</a></div><p dir="ltr" class="mt-7 text-sm text-ink/55">{site.email}<br />{site.whatsappDisplay}</p></div>
    <div id="acquisition" class="border border-gold/40 bg-[#f3f0e7] p-8"><p class="eyebrow">Website acquisition</p><h2 class="urdu mt-3 text-3xl font-bold text-forest">ویب سائٹ کی خریداری</h2><p class="urdu mt-5 leading-[2.1] text-ink/70">یہ ویب سائٹ اور اس سے متعلقہ ڈیجیٹل اثاثے فروخت کے لیے دستیاب ہو سکتے ہیں۔ دلچسپی رکھنے والے خریدار ای میل یا واٹس ایپ کے ذریعے مالک سے رابطہ کر سکتے ہیں۔</p><p dir="ltr" class="mt-4 leading-7 text-ink/60">This website may be available for sale. Interested buyers may contact the owner by email or WhatsApp.</p><div class="mt-8 flex flex-wrap gap-3"><a href={`mailto:${site.email}?subject=Website%20Acquisition%20Inquiry`} class="focus-ring rounded-full bg-gold px-5 py-3 text-sm font-bold text-forest-deep">Contact by Email</a><a href={`${site.whatsappUrl}?text=I%20am%20interested%20in%20the%20Mufti%20Abdul%20Raheem%20website.`} target="_blank" rel="noopener noreferrer" class="focus-ring rounded-full border border-forest/20 px-5 py-3 text-sm font-bold text-forest">Contact on WhatsApp</a></div></div>
  </section>
</BaseLayout>
