---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLectures, topicPairs } from "../../lib/lectures";
const lectures = await getLectures();
const searchData = lectures.map((lecture) => ({
  slug: lecture.data.slug,
  youtubeVideoId: lecture.data.youtubeVideoId,
  originalTitle: lecture.data.originalTitle,
  urduTitle: lecture.data.urduTitle,
  englishTitle: lecture.data.englishTitle,
  publicationDate: lecture.data.publicationDate.toISOString(),
  thumbnailUrl: lecture.data.thumbnailUrl,
  shortUrduSummary: lecture.data.shortUrduSummary,
  englishSummary: lecture.data.englishSummary,
  keyPointsUrdu: lecture.data.keyPointsUrdu,
  keyPointsEnglish: lecture.data.keyPointsEnglish,
  topics: topicPairs(lecture),
  keywords: lecture.data.keywords,
}));
const topicOptions = [...new Set(searchData.flatMap((item) => item.topics.map((topic) => topic.nameEnglish)))].sort();
const yearOptions = [...new Set(searchData.map((item) => new Date(item.publicationDate).getFullYear()))].sort((a, b) => b - a);
---
<BaseLayout title="تلاش | Search Lectures — Mufti Abdul Raheem" description="Search Mufti Abdul Raheem lecture summaries in Urdu and English by title, summary, topic, or keyword.">
  <section class="bg-forest-deep py-16 text-white"><div class="container-site"><p class="eyebrow">Urdu + English</p><h1 class="urdu mt-4 text-5xl font-bold leading-[1.8]">بیانات تلاش کریں</h1><p dir="ltr" class="mt-2 text-white/60">Search titles, summaries, key points, topics, and keywords.</p></div></section>
  <section class="container-site py-12">
    <div class="grid gap-4 border border-forest/12 bg-white p-5 shadow-sm lg:grid-cols-[1fr_190px_140px_150px]">
      <label><span class="sr-only">Search lectures</span><input id="search-input" type="search" placeholder="اردو یا English میں تلاش کریں…" class="focus-ring w-full rounded-none border border-forest/20 bg-paper px-4 py-3.5 text-sm" autocomplete="off" /></label>
      <label><span class="sr-only">Filter by topic</span><select id="topic-filter" class="focus-ring w-full border border-forest/20 bg-paper px-3 py-3.5 text-sm"><option value="">All topics</option>{topicOptions.map((topic) => <option value={topic}>{topic}</option>)}</select></label>
      <label><span class="sr-only">Filter by year</span><select id="year-filter" class="focus-ring w-full border border-forest/20 bg-paper px-3 py-3.5 text-sm"><option value="">All years</option>{yearOptions.map((year) => <option value={year}>{year}</option>)}</select></label>
      <label><span class="sr-only">Sort lectures</span><select id="sort-filter" class="focus-ring w-full border border-forest/20 bg-paper px-3 py-3.5 text-sm"><option value="newest">Newest</option><option value="oldest">Oldest</option></select></label>
    </div>
    <p id="result-count" class="mt-6 text-sm text-ink/50" aria-live="polite"></p>
    <div id="search-results" class="mt-6 grid gap-6 md:grid-cols-2"></div>
    <noscript><p class="border border-gold/30 bg-[#f3f0e7] p-6">Search requires JavaScript. You can still browse all summaries on the <a class="underline" href="/bayan/">Lectures page</a>.</p></noscript>
    <script is:inline id="search-data" type="application/json" set:html={JSON.stringify(searchData).replace(/</g, "\\u003c")}></script>
  </section>
  <script>
    const dataNode = document.querySelector("#search-data");
    const data = JSON.parse(dataNode?.textContent ?? "[]");
    const input = document.querySelector<HTMLInputElement>("#search-input");
    const topic = document.querySelector<HTMLSelectElement>("#topic-filter");
    const year = document.querySelector<HTMLSelectElement>("#year-filter");
    const sort = document.querySelector<HTMLSelectElement>("#sort-filter");
    const results = document.querySelector<HTMLElement>("#search-results");
    const count = document.querySelector<HTMLElement>("#result-count");
    const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" })[char] ?? char);
    const searchable = (item: any) => [item.originalTitle, item.urduTitle, item.englishTitle, item.shortUrduSummary, item.englishSummary, ...item.keyPointsUrdu, ...item.keyPointsEnglish, ...item.topics.flatMap((t: any) => [t.nameUrdu, t.nameEnglish]), ...item.keywords].join(" ").normalize("NFKC").toLocaleLowerCase();
    function render() {
      const query = input?.value.trim().normalize("NFKC").toLocaleLowerCase() ?? "";
      const filtered = data.filter((item: any) => (!query || searchable(item).includes(query)) && (!topic?.value || item.topics.some((t: any) => t.nameEnglish === topic.value)) && (!year?.value || String(new Date(item.publicationDate).getFullYear()) === year.value));
      filtered.sort((a: any, b: any) => (new Date(b.publicationDate).valueOf() - new Date(a.publicationDate).valueOf()) * (sort?.value === "oldest" ? -1 : 1));
      if (count) count.textContent = `${filtered.length} ${filtered.length === 1 ? "summary" : "summaries"}`;
      if (!results) return;
      results.innerHTML = filtered.length ? filtered.map((item: any) => `<article class="overflow-hidden border border-forest/12 bg-white"><a class="block" href="/bayan/${encodeURIComponent(item.slug)}/"><img src="${escapeHtml(item.thumbnailUrl)}" alt="" loading="lazy" width="640" height="360" class="aspect-video w-full object-cover"></a><div class="p-6"><h2 class="urdu text-xl font-bold leading-[1.9] text-forest"><a href="/bayan/${encodeURIComponent(item.slug)}/">${escapeHtml(item.urduTitle)}</a></h2><p dir="ltr" class="mt-1 text-sm text-ink/55">${escapeHtml(item.englishTitle)}</p><p class="urdu mt-4 line-clamp-3 leading-[2] text-ink/65">${escapeHtml(item.shortUrduSummary)}</p></div></article>`).join("") : `<div class="md:col-span-2 border border-dashed border-forest/25 p-10 text-center"><p class="urdu text-xl font-semibold">کوئی نتیجہ نہیں ملا۔</p><p dir="ltr" class="mt-3 text-sm text-ink/50">No matching summaries found.</p></div>`;
    }
    [input, topic, year, sort].forEach((element) => element?.addEventListener("input", render));
    render();
  </script>
</BaseLayout>
