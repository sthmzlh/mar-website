---
const { videoId, title, thumbnailUrl } = Astro.props;
---
<div class="light-youtube relative aspect-video overflow-hidden bg-forest-deep" data-video-id={videoId}>
  <img src={thumbnailUrl} alt="" width="1280" height="720" class="size-full object-cover" />
  <div class="absolute inset-0 bg-forest-deep/20"></div>
  <button type="button" class="focus-ring absolute left-1/2 top-1/2 grid size-20 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full border-4 border-white bg-forest/90 text-2xl text-white shadow-xl transition hover:scale-105" aria-label={`Play ${title}`}><span class="translate-x-0.5" aria-hidden="true">▶</span></button>
</div>
<script>
  document.querySelectorAll<HTMLElement>(".light-youtube").forEach((wrapper) => {
    wrapper.querySelector("button")?.addEventListener("click", () => {
      const id = wrapper.dataset.videoId;
      if (!id) return;
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1`;
      iframe.title = wrapper.querySelector("button")?.getAttribute("aria-label") ?? "YouTube video";
      iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      iframe.className = "absolute inset-0 size-full";
      wrapper.replaceChildren(iframe);
    }, { once: true });
  });
</script>
